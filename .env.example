# Никогда не вставляйте сюда рабочий токен. Скопируйте файл в .env
# локально или заполните переменные в панели хостинга.
DISCORD_TOKEN=
# Некоторые панели хостинга создают BOT_TOKEN автоматически; бот поддерживает оба имени.
# BOT_TOKEN=
APPLICATION_ID=
GUILD_ID=

# Необязательно: пустое значение отключает постоянное подключение к голосовому каналу.
VOICE_CHANNEL_ID=

# Эти значения необязательны: непустое значение переопределяет config/shop.json.
SHOP_NAME=
DISCORD_URL=
TELEGRAM_URL=
PARTNERSHIP_CONTACT=
START_YEAR=

CONFIG_PATH=config/shop.json
DATABASE_PATH=data/shop.sqlite
# В Docker задаётся временный путь, чтобы аварийный рестарт не сохранял старый PID.
LOCK_PATH=
