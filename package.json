{
  "name": "lfr-store-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node index.js",
    "register": "tsx src/register.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx scripts/validate.ts",
    "deploy:check": "npm run check && npm test && npm run validate && npm run build",
    "catalog:import": "tsx scripts/catalog.ts import",
    "catalog:export": "tsx scripts/catalog.ts export"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "better-sqlite3": "12.4.1",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "tsx": "4.20.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
